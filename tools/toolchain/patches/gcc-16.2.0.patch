diff -ruN gcc-16.2.0/gcc/config/ginnos.h ../gcc-16.2.0/gcc/config/ginnos.h
--- a/gcc/config/ginnos.h
+++ b/gcc/config/ginnos.h
@@ -0,0 +1,31 @@
+/* ginnOS: the target definitions for GCC (static executables, our libc) */
+
+#undef TARGET_GINNOS
+#define TARGET_GINNOS 1
+
+/* the C library; libgcc after it for the helpers it uses */
+#undef LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* crt0 starts a program; crti/crtn come with libc, crtbegin/crtend with
+   libgcc (static constructors) */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+/* static only for now; pages of 4 KiB */
+#undef LINK_SPEC
+#define LINK_SPEC "%{shared:-shared} %{!shared:-static} -z max-page-size=0x1000"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()          \
+    do                                    \
+    {                                     \
+        builtin_define("__ginnos__");     \
+        builtin_define("__unix__");       \
+        builtin_assert("system=ginnos");  \
+        builtin_assert("system=unix");    \
+        builtin_assert("system=posix");   \
+    } while (0);
diff -ruN gcc-16.2.0/gcc/config.gcc ../gcc-16.2.0/gcc/config.gcc
